using DataStructuresProject.UX.ProjectClasses;
using Lib.Data.Structures;
using System;
using System.Collections.Generic;
using System.ComponentModel;
using System.Data;
using System.Diagnostics;
using System.Drawing;
using System.Linq;
using System.Text;
using System.Threading.Tasks;
using System.Windows.Forms;
using static System.Windows.Forms.VisualStyles.VisualStyleElement;

namespace DataStructuresProject.UX
{
    public partial class CFormQuery : Form
    {
        private System.Windows.Forms.ToolTip tooltip;

        protected CArrayOrdered<String> OrderedParts = new CArrayOrdered<String>();
        protected CStack<String> UndoStack = new CStack<String>();
        protected CStack<String> RedoStack = new CStack<String>();

        // ----------------------------------------------------------------------------
        public CFormQuery()
        {
            InitializeComponent();
            // Creates the object using a fully qualified class type, and assign properties
            this.tooltip = new System.Windows.Forms.ToolTip()
                                {
                                    InitialDelay = 500,  // mSecs to wait before showing
                                    AutoPopDelay = 5000, // mSecs to keep showing
                                    ReshowDelay = 200,
                                    ShowAlways = true
                                };
            // Set the target where the tooltip will be shown and the text to display
            this.tooltip.SetToolTip(this.picLogo, "Hi! How can I help you?");
        }
        // ----------------------------------------------------------------------------
        private void btnSendMessage_Click(object sender, EventArgs e)
        {
            
            // ----------------------------------------------------------------------------
            // Split the User input into words disregarding all the symbols
            char[] cSeparators = new char[] { ' ', '.', ',', '·', '\t', '\r', '\n' };
            String[] userInput = txtUserInput.Text.Split(cSeparators, StringSplitOptions.RemoveEmptyEntries);

            foreach (String s in userInput)
            {
                // Use the .Add method in the COrderedArray class which automatically finds insert position and sorts the input
                this.OrderedParts.Add(s);
            }
            
            CTokenGrouping tokenGroup = new CTokenGrouping(this.OrderedParts);
            // ----------------------------------------------------------------------------
            this.txtWordsArray.Text = DisplayContents(userInput);
            CToken token = new CToken("", 0);
            Debug.WriteLine(token.DisplayUniques());
            token.BubbleSortByOccurences();
            // ----------------------------------------------------------------------------
            this.txtTokensArray.Text = token.DisplayUniques();
            this.UndoStack.Push(txtUserInput.Text);
            this.txtUserInput.Clear();
            UpdateUndoRedo();
            // ----------------------------------------------------------------------------
        }
        // ----------------------------------------------------------------------------
        private void btnSearch_Click(object sender, EventArgs e)
        {
            CToken token = new CToken("", 0);
            txtTokensArray.Text = token.DisplaySearchValue(this.textBox1.Text);
        }
        // ----------------------------------------------------------------------------
        private void btnUndo_Click(object sender, EventArgs e)
        {
            if(this.UndoStack.ItemCount != 0)
            {
                String UndoString = this.UndoStack.Pop();
                this.RedoStack.Push(txtUserInput.Text);
                txtUserInput.Text = UndoString;
                UpdateUndoRedo();
            }
        }
        //----------------------------------------------------------------------------
        private void btnRedo_Click(object sender, EventArgs e)
        {
            if(this.RedoStack.ItemCount != 0)
            {
                String RedoString = this.RedoStack.Pop();
                this.UndoStack.Push(txtUserInput.Text);
                txtUserInput.Text = RedoString;
                UpdateUndoRedo();
            }
        }
        //-----------------------------------------------------------------------------
        public void UpdateUndoRedo()
        {
            //--------------------------------------------------------------
            txtRedoStack.Clear();
            txtUndoStack.Clear();
            //--------------------------------------------------------------
            if (this.UndoStack.ItemCount == 0)
            {
                txtUndoStack.Text = "";
            }
            else
            {
                foreach (String s in this.UndoStack)
                {
                    txtUndoStack.Text = txtUndoStack.Text + "\r\n" + s;
                }
            }
            //--------------------------------------------------------------
            if (this.RedoStack.ItemCount == 0) 
            {
                txtRedoStack.Text = "";
            }
            else
            {
                foreach (String s in this.RedoStack)
                {
                    txtRedoStack.Text = txtRedoStack.Text + "\r\n" + s;
                }
            }
            //--------------------------------------------------------------
        }
        //-------------------------------------------------------------------------------
        public string DisplayContents(String[] array)
        {
            String DisplayString = "";
            foreach(String s in array)
            {
                DisplayString += s + "\r\n";
            }
            return DisplayString;
        }
        //-------------------------------------------------------------------------------
    }
}
