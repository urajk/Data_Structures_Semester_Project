using DataStructuresProject.UX;

namespace DataStructuresProject
{
    public partial class CFormMain : Form
    {
        private CFormQuery? formQuery = null;

        // ----------------------------------------------------------------------------
        public CFormMain()
        {
            InitializeComponent();
            CFormQueryRouter form = new CFormQueryRouter();
            form.Visible = true;
        }
        // ----------------------------------------------------------------------------
        private void DoOnAnyCommand(object sender, EventArgs e)
        {
            if (sender == btnFormQuery)
            {
                // Create the form when it is first needed. This is called lazy initialization
                if (this.formQuery == null) 
                    this.formQuery = new CFormQuery();
                this.formQuery.Show();
            }
            else if (sender == btnFormQueryRouter)
            {
                //TODO: Add field for form, create and show the form.
            }

            //TODO: Buttons for the rest of the forms

        }
        // ----------------------------------------------------------------------------
    }
}
